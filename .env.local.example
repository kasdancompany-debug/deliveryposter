# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — caption generation (set CAPTION_PROVIDER=openai to enable)
OPENAI_API_KEY=sk-your-key
CAPTION_PROVIDER=mock

# Publisher: mock until Meta OAuth is connected, then meta
PUBLISHER_MODE=mock
MOCK_PUBLISHER_FORCE_FAILURE=false

# Meta Graph API — Facebook Page + Instagram Business OAuth
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://deliveryposter.vercel.app/api/meta/callback
NEXT_PUBLIC_APP_URL=https://deliveryposter.vercel.app

# App
NEXT_PUBLIC_APP_NAME=Delivery Post Studio
NEXT_PUBLIC_DEALERSHIP_NAME=Sault Nissan
