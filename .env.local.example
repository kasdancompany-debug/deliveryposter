# Set true to preview UI without Supabase (localhost demo)
NEXT_PUBLIC_DEMO_MODE=false

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — caption generation (set CAPTION_PROVIDER=openai to enable)
OPENAI_API_KEY=sk-your-key
CAPTION_PROVIDER=mock

# Mock publisher (demo mode always uses mock; set mock to force mock in production)
MOCK_PUBLISHER_FORCE_FAILURE=false
PUBLISHER_MODE=meta

# Meta Graph API — Facebook Page + Instagram Business OAuth
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Must match Valid OAuth Redirect URI in Meta Developer App
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
# Optional: base URL for post-OAuth redirects (defaults from META_REDIRECT_URI)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_NAME=Delivery Post Studio
NEXT_PUBLIC_DEALERSHIP_NAME=Your Dealership
